<?xml version="1.0" encoding="utf-8"?>
<!-- One row in Trip Summary's "GPS Outage Events" list: one card per
     Simulate GPS Loss / Restore GPS Signal cycle. Inflated and filled in
     TripSummaryActivity.renderOutageEvents(); values come from
     AppPrefs.OutageEvent, recorded by MainActivity.toggleGpsOutageMode(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_light_16"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEventTimestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Sep 11, 11:24:27"
            android:textColor="@color/gm_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvEventDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_blue"
            android:backgroundTint="@color/gm_dr_orange"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="46.9s"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/gm_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventGpsKm"
                style="@style/SettingsRowTitle"
                android:textColor="@color/gm_primary_dark"
                android:textSize="15sp"
                android:text="0.004 km" />
            <TextView style="@style/SettingsRowSubtitle" android:text="Real GPS path" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventAiKm"
                style="@style/SettingsRowTitle"
                android:textColor="@color/gm_dr_orange"
                android:textSize="15sp"
                android:text="0.000 km" />
            <TextView style="@style/SettingsRowSubtitle" android:text="AI-DR path" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventDeltaM"
                style="@style/SettingsRowTitle"
                android:textSize="15sp"
                android:text="4 m" />
            <TextView style="@style/SettingsRowSubtitle" android:text="Path &#916;" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/gm_divider" />

    <TextView
        android:id="@+id/tvEventStartCoord"
        style="@style/SettingsRowSubtitle"
        android:textSize="11sp"
        android:text="Start: 17.703190, 83.163370" />

    <TextView
        android:id="@+id/tvEventGpsEndCoord"
        style="@style/SettingsRowSubtitle"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:text="GPS End: 17.703191, 83.163412" />

    <TextView
        android:id="@+id/tvEventAiEndCoord"
        style="@style/SettingsRowSubtitle"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:text="AI-DR End: 17.703193, 83.163384" />

    <TextView
        android:id="@+id/tvEventCorrection"
        style="@style/SettingsRowSubtitle"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:text="Correction distance: 2.9 m" />

</LinearLayout>
