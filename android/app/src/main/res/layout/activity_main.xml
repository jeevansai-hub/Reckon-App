<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- OpenStreetMap MapView (osmdroid), full bleed behind everything -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============ TOP: floating search bar + status chip + outage banner ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:orientation="vertical">

        <!-- Google Maps style floating pill search bar -->
        <LinearLayout
            android:id="@+id/searchBarRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_bar"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_menu_hamburger" />

            <TextView
                android:id="@+id/tvSearchLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Search here"
                android:textColor="@color/gm_on_surface_variant"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="R"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_chip"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvGpsStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE: LIVE GPS"
                android:textColor="@color/gm_success_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Prominent Outage Alert Banner (Visible during outage) -->
        <LinearLayout
            android:id="@+id/llOutageBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_outage_banner_gradient"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvOutageBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ GPS LOST: AI ESTIMATING"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOutageTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outage: 0.0s"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ RIGHT: floating FAB rail, anchored just above the bottom sheet ============ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|end"
        android:translationY="-14dp">

        <FrameLayout
            android:id="@+id/fabLayers"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_fab_white"
            android:elevation="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_layers" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fabRecenter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_fab_white"
            android:elevation="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_recenter" />
        </FrameLayout>
    </LinearLayout>

    <!-- ============ Draggable bottom sheet: telemetry + primary controls ============ -->
    <!-- Drawn BEFORE the nav bar (below it in z-order) and padded at the bottom
         by the nav bar's own height, so the opaque white nav bar cleanly masks
         the sheet's bottom padding when collapsed instead of covering content. -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="70dp">

        <FrameLayout
            android:id="@+id/dragHandleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_gesture_bar" />

            <ImageView
                android:id="@+id/ivExpandChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_expand_more" />
        </FrameLayout>

        <!-- Title & Mode Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reckon AI"
                android:textColor="@color/gm_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Everything below is hidden until the drag handle is tapped, so the
             collapsed peek only shows the title + primary action (see
             expandableDetails toggle in MainActivity.onCreate). -->
        <LinearLayout
            android:id="@+id/expandableDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/gm_divider" />

        <!-- Row 1: Real GPS vs AI-ML Dead Reckoning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Real GPS Column (Blue) -->
            <LinearLayout
                android:id="@+id/llGpsColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGpsHeaderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵 Real GPS Fix"
                    android:textColor="@color/gm_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGpsCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat: --\nLon: --"
                    android:textColor="@color/gm_on_surface_variant"
                    android:textSize="11sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tvGpsSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed: 0.0 km/h"
                    android:textColor="@color/gm_on_surface"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- AI+Physics DR Column (Orange) -->
            <LinearLayout
                android:id="@+id/llAiColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAiHeaderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟠 AI + Physics DR"
                    android:textColor="@color/gm_dr_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat: --\nLon: --"
                    android:textColor="@color/gm_on_surface_variant"
                    android:textSize="11sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tvAiMotion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed: 0.0 km/h | ψ: --°"
                    android:textColor="@color/gm_on_surface"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/gm_divider" />

        <!-- Drift, Outage & Window stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDriftDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Separation: 0.0 m (0.00%)"
                android:textColor="@color/gm_warning_amber"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWindowCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Window #0"
                android:textColor="@color/gm_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Real GPS path distance vs AI-DR estimated path distance, both in
             km, accumulated between "Simulate GPS Loss" and "Restore GPS
             Signal" clicks. Only meaningful during/after an outage; blank
             (GONE) otherwise. See updateOutageDistanceCompare() in
             MainActivity. -->
        <TextView
            android:id="@+id/tvOutageDistanceCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="GPS: 0.000 km | AI-DR: 0.000 km"
            android:textColor="@color/gm_on_surface_variant"
            android:textSize="11sp"
            android:visibility="gone" />
        </LinearLayout>
        <!-- end expandableDetails -->

        <!-- Primary Toggle Button: Simulate GPS Loss / Restore GPS (compact pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleGpsOutage"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Simulate GPS Loss"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gm_alert_red"
            app:cornerRadius="999dp"
            app:elevation="2dp"
            app:icon="@android:drawable/ic_dialog_alert"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetOrigin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Reset Origin"
                android:textColor="@color/gm_on_surface"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/gm_outline" />

            <Button
                android:id="@+id/btnVerifyTests"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Benchmarks"
                android:textColor="@color/gm_primary_dark"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/gm_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ BOTTOM: persistent nav bar, pinned on top of the sheet ============ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="10dp"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
