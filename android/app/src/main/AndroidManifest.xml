<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeadReckoningApp">

        <!-- App entry point: boot checklist splash, then onboarding (first run) or straight to the map -->
        <activity
            android:name="com.sih26168.deadreckoning.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ReckonAI.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.sih26168.deadreckoning.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.ReckonAI.Light" />

        <activity
            android:name="com.sih26168.deadreckoning.onboarding.PermissionsActivity"
            android:exported="false"
            android:theme="@style/Theme.ReckonAI.Light" />

        <activity
            android:name="com.sih26168.deadreckoning.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ReckonAI.Light" />

        <activity
            android:name="com.sih26168.deadreckoning.trip.TripSummaryActivity"
            android:exported="false"
            android:theme="@style/Theme.ReckonAI.Light" />

        <activity
            android:name="com.sih26168.deadreckoning.ui.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.ReckonAI.Light" />

        <!-- Main Live Map & Dual Marker Navigation Activity (osmdroid) -->
        <activity
            android:name="com.sih26168.deadreckoning.ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DeadReckoningApp" />

        <!-- Benchmark Verification Dashboard -->
        <activity
            android:name="com.sih26168.deadreckoning.test.OnnxVerificationActivity"
            android:exported="true"
            android:theme="@style/Theme.DeadReckoningApp" />
    </application>

</manifest>
